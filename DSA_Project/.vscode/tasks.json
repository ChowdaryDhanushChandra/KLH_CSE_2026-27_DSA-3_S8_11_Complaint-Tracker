{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run TextHack (javafx:run)",
            "type": "shell",
            "command": ".\\mvnw.cmd",
            "args": ["javafx:run"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Run All Tests",
            "type": "shell",
            "command": ".\\mvnw.cmd",
            "args": ["test"],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Package JAR",
            "type": "shell",
            "command": ".\\mvnw.cmd",
            "args": ["package", "-DskipTests"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
